<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= blogName %></title>
  <link rel="stylesheet" href="/dashboard-assets/style.css">
</head>
<body style="background: var(--paper); margin: 0;">
  <header style="background: var(--ink); padding: 56px 24px;">
    <div style="max-width: 640px; margin: 0 auto;">
      <div class="meta" style="color: #8b8578; margin-bottom: 10px;">a quill blog</div>
      <h1 style="color: #fff; font-size: 38px; margin: 0;"><%= blogName %></h1>
    </div>
  </header>

  <main style="max-width: 640px; margin: 0 auto; padding: 48px 24px 100px;">
    <% if (posts.length === 0) { %>
      <p style="color: var(--text-muted); font-size: 16px;">No posts published yet. Check back soon.</p>
    <% } %>

    <% posts.forEach(post => { %>
      <article style="padding: 28px 0; border-bottom: 1px solid var(--border);">
        <a href="/blog/<%= userId %>/<%= post.slug || post.id %>" style="text-decoration: none; color: inherit;">
          <h2 style="font-size: 24px; font-weight: 600; margin: 0 0 10px; line-height: 1.3;"><%= post.title %></h2>
          <% if (post.meta_description) { %>
            <p style="color: var(--text-muted); font-size: 16px; line-height: 1.6; margin: 0 0 12px;"><%= post.meta_description %></p>
          <% } %>
          <div class="meta" style="color: #9a9484;">
            <%= new Date(post.published_at).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %>
          </div>
        </a>
      </article>
    <% }) %>
  </main>
</body>
</html>
<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= post.meta_title || post.title %></title>
  <% if (post.meta_description) { %>
    <meta name="description" content="<%= post.meta_description %>">
  <% } %>
  <link rel="stylesheet" href="/dashboard-assets/style.css">
  <style>
    .prose { font-size: 18px; line-height: 1.8; color: var(--text); }
    .prose h1, .prose h2, .prose h3 { font-family: 'Source Serif 4', serif; margin-top: 36px; margin-bottom: 12px; }
    .prose p { margin-bottom: 20px; }
    .prose pre { background: var(--ink); color: #e5e2d6; padding: 18px; border-radius: 8px; overflow-x: auto; font-family: 'JetBrains Mono', monospace; font-size: 14px; margin-bottom: 20px; }
    .prose code { font-family: 'JetBrains Mono', monospace; background: #efece3; padding: 2px 6px; border-radius: 4px; font-size: 14px; }
    .prose pre code { background: none; padding: 0; }
    .prose a { color: var(--accent); }
    .prose img { max-width: 100%; border-radius: 8px; margin: 20px 0; }
    .prose ul, .prose ol { margin-bottom: 20px; padding-left: 24px; }
    .prose blockquote { border-left: 3px solid var(--accent); padding-left: 18px; color: var(--text-muted); font-style: italic; margin: 24px 0; }
  </style>
</head>
<body style="background: var(--paper); margin: 0;">
  <header style="background: var(--ink); padding: 56px 24px 44px;">
    <div style="max-width: 640px; margin: 0 auto;">
      <a href="/blog/<%= userId %>" style="color: #8b8578; text-decoration: none; font-size: 14px;">← Back to blog</a>
      <h1 style="color: #fff; font-size: 36px; margin: 18px 0 10px; line-height: 1.25;"><%= post.title %></h1>
      <div class="meta" style="color: #8b8578;">
        <%= new Date(post.published_at).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %>
      </div>
    </div>
  </header>

  <main style="max-width: 640px; margin: 0 auto; padding: 48px 24px 100px;">
    <div class="prose"><%- contentHtml %></div>
  </main>
</body>
</html>